<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<OfficeApp xmlns="http://schemas.microsoft.com/office/appforoffice/1.1"
           xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
           xmlns:bt="http://schemas.microsoft.com/office/officeappbasictypes/1.0"
           xsi:type="MailApp">
  <Id>2e8f5d4d-29c3-4ba9-ae3f-7b2d4f8a1004</Id>
  <Version>0.1.0.0</Version>
  <ProviderName>Time Worthy Media</ProviderName>
  <DefaultLocale>en-US</DefaultLocale>
  <DisplayName DefaultValue="ikmal editor"/>
  <Description DefaultValue="Local writing review for Microsoft Outlook."/>
  <IconUrl DefaultValue="https://localhost:8765/office/outlook/icon.svg"/>
  <HighResolutionIconUrl DefaultValue="https://localhost:8765/office/outlook/icon.svg"/>
  <SupportUrl DefaultValue="https://localhost:8765/office/outlook/"/>
  <AppDomains>
    <AppDomain>https://localhost:8765</AppDomain>
  </AppDomains>
  <Hosts>
    <Host Name="Mailbox">
      <DesktopFormFactor>
        <FunctionFile resid="Commands.Url"/>
        <ExtensionPoint xsi:type="MessageComposeCommandSurface">
          <OfficeTab id="TabDefault">
            <Group id="CommandsGroup">
              <Label resid="GroupLabel"/>
              <Control xsi:type="Button" id="MessageComposeCommandButton">
                <Label resid="TaskpaneButton.Label"/>
                <Supertip>
                  <Title resid="TaskpaneButton.Label"/>
                  <Description resid="TaskpaneButton.Tooltip"/>
                </Supertip>
                <Icon>
                  <bt:Image size="16" resid="Icon.16x16"/>
                  <bt:Image size="32" resid="Icon.32x32"/>
                  <bt:Image size="80" resid="Icon.80x80"/>
                </Icon>
                <Action xsi:type="ShowTaskpane">
                  <SourceLocation resid="Taskpane.Url"/>
                </Action>
              </Control>
            </Group>
          </OfficeTab>
        </ExtensionPoint>
      </DesktopFormFactor>
    </Host>
  </Hosts>
  <Requirements><Sets DefaultMinVersion="1.3"><Set Name="Mailbox" MinVersion="1.3"/></Sets></Requirements>
  <FormSettings>
    <Form xsi:type="ItemEdit">
      <DesktopSettings>
        <SourceLocation resid="Taskpane.Url"/>
        <RequestedHeight>450</RequestedHeight>
      </DesktopSettings>
    </Form>
  </FormSettings>
  <Permissions>ReadWriteMailbox</Permissions>
  <Rule xsi:type="Rule" ItemIs="Message" FormType="Edit"/>
  <DisableEntityHighlighting>true</DisableEntityHighlighting>
  <Resources>
    <bt:Images xmlns:bt="http://schemas.microsoft.com/office/officeappbasictypes/1.0">
      <bt:Image id="Icon.16x16" DefaultValue="https://localhost:8765/office/outlook/icon.svg"/>
      <bt:Image id="Icon.32x32" DefaultValue="https://localhost:8765/office/outlook/icon.svg"/>
      <bt:Image id="Icon.80x80" DefaultValue="https://localhost:8765/office/outlook/icon.svg"/>
    </bt:Images>
    <bt:Urls xmlns:bt="http://schemas.microsoft.com/office/officeappbasictypes/1.0">
      <bt:Url id="Commands.Url" DefaultValue="https://localhost:8765/office/outlook/commands.html"/>
      <bt:Url id="Taskpane.Url" DefaultValue="https://localhost:8765/office/outlook/"/>
    </bt:Urls>
    <bt:ShortStrings xmlns:bt="http://schemas.microsoft.com/office/officeappbasictypes/1.0">
      <bt:String id="GroupLabel" DefaultValue="ikmal editor"/>
      <bt:String id="TaskpaneButton.Label" DefaultValue="Review with ikmal"/>
    </bt:ShortStrings>
    <bt:LongStrings xmlns:bt="http://schemas.microsoft.com/office/officeappbasictypes/1.0">
      <bt:String id="TaskpaneButton.Tooltip" DefaultValue="Review this draft locally with ikmal editor"/>
    </bt:LongStrings>
  </Resources>
</OfficeApp>
