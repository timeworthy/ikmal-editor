<?xml version="1.0" encoding="UTF-8"?>
<!-- Ikmal Editor: Battle-Tested Plain English & Conciseness Rule Pack -->
<rules lang="en" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
       xsi:noNamespaceSchemaLocation="../rules.xsd">

  <category id="IKMAL_CONCISENESS" name="Ikmal Conciseness &amp; Plain English">
    <rule id="IKMAL_WORDINESS_IN_ORDER_TO" name="Simplify &quot;in order to&quot;">
      <pattern>
        <token>in</token><token>order</token><token>to</token>
      </pattern>
      <message>Consider simplifying for conciseness: <suggestion>to</suggestion></message>
      <example correction="to">We should <marker>in order to</marker> simplify our writing.</example>
    </rule>
