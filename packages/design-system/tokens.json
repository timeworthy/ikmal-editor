{
  "$schema": "https://design-tokens.org/format",
  "name": "Continental",
  "description": "Portable semantic tokens for the ikmal rewrite, derived from the Continental design authority.",
  "source": "Continental design system / continental-ds/tokens.json",
  "version": "1.0.0",
  "axes": {
    "dialect": ["shelf", "rift", "hillshade", "contour", "tide", "basin", "island", "cave"],
    "theme": ["dark", "light"],
    "palette": ["slate", "bathymetric", "sediment", "ultraviolet", "aurora", "parchment"],
    "density": ["compact", "comfortable", "spacious"],
    "contrast": ["normal", "high"]
  },
  "semantic": {
    "color": {
      "bg-0": "#15151b",
      "bg-1": "#1c1c24",
      "bg-2": "#26262f",
      "bg-pop": "#0f0f14",
      "fg-1": "#e8e8ec",
      "fg-2": "#c4c4cc",
      "fg-3": "#9a9aa6",
      "fg-4": "#6e6e7a",
      "border-1": "rgba(232,232,236,0.13)",
      "border-2": "rgba(232,232,236,0.22)",
      "accent": "#7b6cd9",
      "accent-hover": "#9486e6",
      "accent-press": "#6354c4",
      "accent-soft": "rgba(123,108,217,0.14)",
      "accent-fg": "#ffffff",
      "success": "#6fa37c",
      "warning": "#e0a458",
      "danger": "#d67560",
      "info": "#6b8aaf"
    },
    "radius": { "1": "6px", "2": "10px", "3": "16px", "pill": "999px" },
    "space": { "1": "4px", "2": "8px", "3": "12px", "4": "16px", "5": "24px", "6": "32px", "7": "48px", "8": "64px" },
    "type": {
      "sans": "'Inter Tight', system-ui, sans-serif",
      "serif": "Spectral, Georgia, serif",
      "mono": "'IBM Plex Mono', ui-monospace, monospace"
    },
    "shadow": {
      "pop": "0 12px 32px rgba(0,0,0,0.28), 0 2px 8px rgba(0,0,0,0.18)",
      "focus": "0 0 0 3px var(--accent-soft)"
    },
    "motion": {
      "ease-default": "cubic-bezier(0.65,0,0.35,1)",
      "ease-spring": "cubic-bezier(0.34,1.56,0.64,1)",
      "dur-fast": "120ms",
      "dur-default": "200ms",
      "dur-modal-in": "360ms"
    }
  }
}
